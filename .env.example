# ==============================================================
# 環境変数テンプレート（東京都市大学 第97回 世田谷祭 公式Webサイト）
# このファイルを .env.local にコピーして値を設定する:
#   cp .env.example .env.local
# 機密値（APIキー・SMTPパスワード等）は絶対にコミットしないこと
# ==============================================================

# --------------------------------------------------------------
# microCMS（news / events / informations の取得に使用）
# --------------------------------------------------------------
# サービスドメインは「サブドメイン名のみ」を指定する（https:// や .microcms.io は含めない）
# 例: 管理画面URLが https://example.microcms.io の場合 → example
# ※ 未設定でもビルド・起動は可能（API呼び出しは空データを返す。CI等を想定 / src/lib/microcms.ts）
MICROCMS_SERVICE_DOMAIN=example
MICROCMS_API_KEY=your-api-key

# --------------------------------------------------------------
# コンテンツ公開フラグ（src/data/site.ts で参照）
# --------------------------------------------------------------
# "true" のときのみ公開。未設定・それ以外の値はすべて非公開（安全側デフォルト）
# ビルド時に評価されるため、変更後は再デプロイ（再ビルド）が必要
# EVENTS: /events・/timetable・トップのおすすめ企画・企画詳細・sitemapの企画URLを一括制御
NEXT_PUBLIC_EVENTS_VISIBLE=false
# NEWS: /info 一覧のみ制御（トップのNews・お知らせ詳細・sitemapは常時公開）
NEXT_PUBLIC_NEWS_VISIBLE=false
# SPECIAL: 著名人企画（type = special）を全面制御。EVENTS_VISIBLE とは独立したフラグ
# false のとき /special は準備中表示、/special/[id] は生成されず404、トップの告知セクションも非表示
# 企画一覧・タイムテーブル・おすすめ企画・sitemap からも type = special を除外する
# 著名人は解禁日が契約で決まる。microCMS 側を下書きにするだけで済ませず、必ずこのフラグでも塞ぐこと
NEXT_PUBLIC_SPECIAL_VISIBLE=false
# SPECIAL_GOODS: 著名人企画の物販情報だけを制御。プロフィール・出演情報・チケット等とは独立
# false のとき /special/[id] の物販欄のみ非表示
NEXT_PUBLIC_SPECIAL_GOODS_VISIBLE=false

# --------------------------------------------------------------
# サイトURL（canonical / OGP / sitemap の生成に使用）
# --------------------------------------------------------------
# 未設定時は https://setagayafes.org にフォールバック（src/data/site.ts）
NEXT_PUBLIC_URL=https://setagayafes.org

# --------------------------------------------------------------
# お問い合わせフォーム（/api/contact・Nodemailer）
# --------------------------------------------------------------
# SMTP_* のいずれかが未設定の場合、フォーム送信はエラーを返す
# SMTP_PORT=465 のときのみ SSL/TLS（secure）で接続する
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
# 送信先・送信元（省略時は src/app/api/contact/route.ts 内の既定値を使用）
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=noreply@example.com

# --------------------------------------------------------------
# 任意（開発・分析）
# --------------------------------------------------------------
# バンドルサイズ分析: ANALYZE=true pnpm build で有効化（next.config.ts）
# ANALYZE=true

# Google Tag Manager（現在コード未参照・将来導入時の予約枠）
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
